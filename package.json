    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "googleapis": "^159.0.0",
    "ioredis": "^5.7.0",
    "joi": "^18.0.1",
